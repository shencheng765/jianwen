{
  "name": "plain-text-ai",
  "version": "1.5.8",
  "private": true,
  "description": "简文：专注文本、命令与 AI 提醒的中文编辑器",
  "author": "Local",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "vite build",
    "start": "electron .",
    "package": "npm run build && powershell.exe -NoProfile -ExecutionPolicy Bypass -File native/package.ps1",
    "package:installer": "npm run package && powershell.exe -NoProfile -ExecutionPolicy Bypass -File native/installer.ps1",
    "package:electron": "npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "dictionary-en": "4.0.0",
    "dompurify": "3.4.17",
    "iconv-lite": "0.7.3",
    "marked": "18.1.2",
    "nspell": "2.1.5"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "monaco-editor": "0.57.0",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "local.jianwen.editor",
    "productName": "简文",
    "copyright": "Copyright © 2026",
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": true,
      "artifactName": "Jianwen-${version}-Windows-x64.exe"
    },
    "portable": {
      "requestExecutionLevel": "user"
    }
  },
  "overrides": {
    "fs-extra@^11": "11.4.1"
  }
}
